# Secrets — never commit
.env
*.env
.env.*
!_env          # keep the template

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
dist/
build/
*.egg-info/
wago_proxy.py

# uv lockfile (optional — commit if you want reproducible builds)
# uv.lock

# Logs
*.log

# Docker
docker-compose.override.yml

# Editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# ── Claude Code ──

.claude/settings.local.json

# ── CRA / build artifacts ──
# Ephemeral build-time SBOM at repo root (regenerated every build).
# Leading slash keeps released SBOMs under sbom/ tracked.
/sbom*.json
/sbom/
# Docker secrets (T2) — credentials must never be committed at rest
/secrets/
# Auto-generated API key persistence volume (T1)
/data/

.claude/
.mcp.json
# Internal planning files — keep private
docs/*-todo.md
docs/*-todos.md
docs/tier*
docs/integrations-plan.md
CLAUDE.md

# Obsidian vault config (editor artifact, not repo content)
docs/.obsidian/

# graphify knowledge-graph cache — regenerated locally, not release content
/graphify-out/

# Source video recordings — GIFs are committed instead
docs/media/*.mp4

# Connector/integration sketches — local only until ready to publish
/integrations/

claude_desktop_config.json
.firecrawl/
src/*.egg-info/

# serena MCP tool state
.serena/

# local dev compose override
docker-compose.dev.yml

# tests: root-level test modules are tracked; scratch subdirs stay local
/tests/*
!/tests/__init__.py
!/tests/test_*.py
