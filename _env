# ─────────────────────────── wago-plc-mcp config ───────────────────────────
# Copy to .env and customize for your deployment.

# ── PLC list (pick ONE format, or combine; format 2 overrides format 1) ──

# Format 1 — Shared credentials, comma-separated IPs (simplest):
WAGO_PLC_HOSTS=192.168.2.17,192.168.42.42
# Format 2 — Per-PLC credentials (use underscores in IP keys):
# PLC_PASSWORDS_10_0_0_1=secret_a
# PLC_PASSWORDS_10_0_0_2=secret_b
# PLC_PASSWORDS_10_0_0_3=secret_c

# ── Default credentials ──
DEFAULT_PLC_USERNAME=admin

# DEPRECATED: Store the password as a Docker Secret instead (recommended for production).
# Create secrets/plc_default_password.txt and declare it in docker-compose.yml.
# This env var is kept as a dev/local fallback only — remove it from .env in production.
# DEFAULT_PLC_PASSWORD=wago

# ── T1: Bearer auth on /mcp (recommended for production) ──
# Store the key as a Docker Secret (highest priority):
#   echo "$(openssl rand -hex 32)" > secrets/mcp_api_key.txt
#   chmod 600 secrets/mcp_api_key.txt
#   # then uncomment mcp_api_key in docker-compose.yml secrets section
# Fallback (dev only — prefer the secret):
# MCP_API_KEY=your-random-hex-key
#
# Add to .mcp.json when auth is enabled:
#   "headers": {"Authorization": "Bearer <your-key>"}

# ── MCP server bind ──
HOST=0.0.0.0
PORT=6042
#TRANSPORT=sse
TRANSPORT=streamable-http
# ── Optional tuning ──
# Connection timeout per PLC HTTP request, in seconds (default 5)
WAGO_TIMEOUT_SECONDS=15

# Page size when walking large collections (default 500)
WAGO_PAGE_LIMIT=500

# Log level: DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=INFO
# Semaphore in register_many — max 5 PLCs parallel 
WAGO_MAX_CONCURRENT_REGISTRATIONS=5
# PLC Timeout
WAGO_TIMEOUT_SECONDS=45

# Log file path inside container (default /app/mcp_server.log)
LOG_FILE=/app/mcp_server.log
