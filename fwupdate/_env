# Copy to .env and fill in. .env is gitignored at the project root.
PLC_IP=192.168.2.217
PLC_USERNAME=admin
PLC_PASSWORD=changeme

# Host directory holding .wup firmware bundles - mounted read-only into the
# container. The device's order number and current firmware version are
# read live and matched against every bundle's own package-info.xml to pick
# the right one automatically. See catalog.py.
FIRMWARE_HOST_DIR=/home/wago/Documents/mcp/fw

# Optional: exact target firmware revision, e.g. "4.9.1". Leave unset to
# auto-pick the highest-revision compatible bundle available ("latest").
#TARGET_VERSION=4.9.1

# Optional: bypass catalog resolution entirely and use exactly this bundle
# (a path *inside the container*, under /firmware/). Leave unset for
# catalog mode (recommended).
#WUP_PATH=/firmware/PFC-G2-Linux_update_V040901_31_r9d0900aaed.wup

# Optional overrides
CHUNK_SIZE=4000000
POLL_INTERVAL=6
POLL_TIMEOUT=900
