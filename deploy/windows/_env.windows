# ─────────────────────── wago-plc-mcp config (Windows) ───────────────────────
# Generated by setup.bat — edit this file, then restart wago-mcp-server.exe.

# ── PLC list ──
# Comma-separated IPs (shared credentials):
WAGO_PLC_HOSTS=192.168.42.110

# Or point to a text file, one IP per line (# comments ignored):
# WAGO_PLC_HOSTS_FILE=data\fleet.txt

# ── Credentials ──
DEFAULT_PLC_USERNAME=admin
DEFAULT_PLC_PASSWORD=wago

# ── Proxy target (used by wago-proxy.exe and Claude Desktop) ──
WAGO_MCP_URL=http://localhost:6042/mcp

# ── Optional: Bearer auth on /mcp ──
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
# Then set the same key in claude_desktop_config.json env block.
# MCP_API_KEY=

# ── MCP server bind ──
HOST=0.0.0.0
PORT=6042
TRANSPORT=streamable-http

# ── Timeouts / tuning ──
WAGO_TIMEOUT_SECONDS=45
WAGO_PAGE_LIMIT=500
WAGO_MAX_CONCURRENT_REGISTRATIONS=5

# ── Logging (relative paths — logs land next to the exe) ──
LOG_LEVEL=INFO
LOG_FILE=mcp_server.log
AUDIT_LOG_FILE=data\audit.log
